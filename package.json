{
  "name": "fpv-rig",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Offline FPV simulator: laptop physics and rendering, Android phone as a real transmitter over USB",
  "license": "MIT",
  "author": "Mitrakulal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitrakulal/FPV.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "dev": "npm run build && npm run start",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test tests/physics.test.ts tests/protocol.test.ts",
    "smoke": "node tools/smoke.ts",
    "typecheck": "tsc --noEmit",
    "launcher:build": "node scripts/build-launcher.mjs",
    "launcher": "npm run build && node scripts/build-launcher.mjs && node scripts/run-launcher.mjs",
    "fetch:adb": "node scripts/fetch-adb.mjs",
    "package:win": "node scripts/package-win.mjs"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.15.0",
    "typescript": "^7.0.2"
  }
}
